# Copy to root .env only if one does not exist. No real credentials belong here.
# Next sets NODE_ENV; omit it from this file.
DATABASE_URL=postgresql://minecentral:replace-local-db-password@localhost:5432/minecentral
BETTER_AUTH_SECRET=replace-with-random-secret-at-least-32-characters
REVALIDATION_SECRET=replace-with-separate-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Optional providers: configure both ID and secret to enable a sign-in button.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT=http://localhost:3000/api/auth/callback/discord
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
UPLOADTHING_TOKEN=
SERVERLIST_MAX_SERVERS_PER_USER=5

# Optional legacy integrations; leave empty unless used.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
HOST_PTERO_API_KEY=
HOST_PTERO_API_URL=
HOST_PTERO_SERVER_CREATE=false
GITHUB_ACCESS_TOKEN=

# Future modules remain disabled until implemented and approved for release.
FEATURE_V2_WORKSPACES=false
FEATURE_V2_COMMUNITY=false
FEATURE_V2_AGENT=false

# Optional PostgreSQL pool size (1–100; default 10)
DATABASE_POOL_MAX=10
